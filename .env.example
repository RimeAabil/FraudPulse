# ═══════════════════════════════════════════════════════════════
#  FraudPulse — Centralized Environment Configuration Template
#  Copy to .env and fill in your values before running.
# ═══════════════════════════════════════════════════════════════

# ─── Kafka KRaft Cluster ─────────────────────────────────────
# Generate with: docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=REPLACE_WITH_GENERATED_UUID

KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_ISR=2
KAFKA_NUM_PARTITIONS=6
KAFKA_LOG_RETENTION_HOURS=72
KAFKA_LOG_SEGMENT_BYTES=1073741824

# Broker external ports (host:container)
KAFKA_1_EXTERNAL_PORT=9092
KAFKA_2_EXTERNAL_PORT=9094
KAFKA_3_EXTERNAL_PORT=9096

# ─── Kafka Topics ─────────────────────────────────────────────
KAFKA_TOPIC=fraud-transactions
KAFKA_DLQ_TOPIC=fraud-transactions-dlq
KAFKA_PREDICTIONS_TOPIC=model-predictions
KAFKA_METRICS_TOPIC=pipeline-metrics

# ─── Schema Registry ──────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ─── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB=fraud_db
MONGO_COLLECTION=transactions
MONGO_INITDB_DATABASE=fraud_db

# ─── Spark ────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2
SPARK_CHECKPOINT_DIR=/opt/spark/checkpoints
FRAUD_THRESHOLD=0.5

# ─── Producer ─────────────────────────────────────────────────
STREAM_DELAY_SECONDS=0.05
PRODUCER_BATCH_SIZE=32768
PRODUCER_LINGER_MS=10
PRODUCER_COMPRESSION=lz4
PRODUCER_MAX_RETRIES=5

# ─── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=FraudPulse-XGBoost
MODEL_NAME=FraudPulse-XGBoost
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow/mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# ─── Model Server ─────────────────────────────────────────────
MODEL_SERVER_PORT=8000
MODEL_SERVER_HOST=model-server
AB_TEST_CHALLENGER_FRACTION=0.10

# ─── Observability ────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_in_production
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601

# ─── Dashboard  (DO NOT CHANGE — UI constraint) ───────────────
DASHBOARD_PORT=8501

# ─── Security (fill before production deployment) ─────────────
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# MONGO_USERNAME=
# MONGO_PASSWORD=
# GRAFANA_SECRET_KEY=
